{
  "entity": {
    "binary_sensor": {
      "blade_change_due": {
        "default": "mdi:saw-blade"
      },
      "problem": {
        "default": "mdi:robot-mower-outline"
      },
      "pin_protection": {
        "default": "mdi:shield-lock",
        "state": {
          "off": "mdi:shield-off-outline"
        }
      },
      "geofence": {
        "default": "mdi:map-marker-radius",
        "state": {
          "off": "mdi:map-marker-off-outline"
        }
      }
    },
    "switch": {
      "winter_pause": {
        "default": "mdi:snowflake",
        "state": {
          "off": "mdi:snowflake-off"
        }
      }
    },
    "event": {
      "error": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "calendar": {
      "calendar": {
        "default": "mdi:calendar-clock"
      }
    },
    "sensor": {
      "status_text": {
        "default": "mdi:message-text-outline"
      }
    },
    "button": {
      "park_2h": {
        "default": "mdi:timer-pause-outline"
      },
      "park_rest_of_day": {
        "default": "mdi:weather-night"
      },
      "continuous_2_days": {
        "default": "mdi:robot-mower"
      },
      "continuous_1_week": {
        "default": "mdi:robot-mower"
      },
      "continuous_off": {
        "default": "mdi:robot-mower-outline"
      }
    }
  },
  "services": {
    "park": {
      "service": "mdi:home-import-outline"
    },
    "mow_continuously": {
      "service": "mdi:robot-mower"
    }
  }
}
