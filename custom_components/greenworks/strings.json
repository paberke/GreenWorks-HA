  "options": {
    "step": {
      "init": {
        "title": "Settings",
        "description": "Which entities are shown and how the integration works. Switched-off entities are disabled, not deleted, so their entity IDs stay the same. Tip for winter: switch on the “Winter pause” switch on the mower's device page – then there are no offline notices and Problem stays OK. Nothing is changed on the mower.",
        "data": {
          "groups": "Additional entities",
          "scan_interval": "Update interval (30–600 seconds)",
          "outage_grace": "Keep last values during drops (1–60 minutes)",
          "blade_limit": "Blade change after (0 = off, 0–1000 hours)",
          "offline_hours": "Repair notice when offline for (0 = off, 0–72 hours)"
        }
      }
    }
  },
  "selector": {
    "groups": {
      "options": {
        "errors_detailed": "Detailed errors (error code, last error, error message with history, fatal errors)",
        "statistics": "Statistics (mowing, running and charging time, statistics date, last status message)",
        "app_settings": "Settings from the app (schedule, drive past wire, wire distance, start points, rain and frost guard)",
        "diagnostics": "Diagnostics (software, signal quality, software update)",
        "calendar": "Calendar (mowing schedule as calendar events)",
        "position": "Position (mower on the map)"
      }
    }
  },
  "issues": {
    "mower_offline": {
      "title": "{name} is offline",
      "description": "The mower {name} has been offline for more than {hours} hour(s). Check the mower (switched on? stuck? mobile signal?). The notice disappears by itself as soon as the mower is back online. In winter, switch on “Winter pause” to suppress this notice."
    },
    "cloud_unreachable": {
      "title": "Greenworks cloud not reachable",
      "description": "The Greenworks cloud has not been reachable for more than {hours} hour(s). Check your internet connection. The notice disappears by itself as soon as the cloud answers again."
    }
  },
  "exceptions": {
    "auth_failed": {
      "message": "The Greenworks cloud rejected the password. Please re-authenticate."
    },
    "cloud_unreachable": {
      "message": "Greenworks cloud not reachable: {error}"
    }
  }
